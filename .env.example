# Shared bearer token used to authenticate both /v1/logs (OTLP ingestion,
# reachable on host port 9585 so dev containers can report) and /api/* (the
# dashboard's read endpoints, proxied through nginx).
#
# Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(20))"
#
# Ingest REFUSES TO START if this is blank, unless INGEST_ALLOW_ANONYMOUS is
# set below. That is deliberate: a missing .env used to bring the stack up
# completely open while still reporting healthy.
INGEST_AUTH_TOKEN=

# Set to true ONLY to deliberately run with authentication disabled on a
# trusted private network. Ingest logs a loud warning at startup when it is on.
#INGEST_ALLOW_ANONYMOUS=true

# ── Behaviour ─────────────────────────────────────────────────────────────
# Minutes a session may go quiet before it stops counting as active. Also the
# grace period before a session that never logged usage is purged.
#ACTIVE_WINDOW_MINUTES=15

# DEBUG, INFO, WARNING, ERROR. Backup and purge activity is logged at INFO.
#LOG_LEVEL=INFO

# ── Backup ────────────────────────────────────────────────────────────────────
# Leave BACKUP_DESTINATION blank to disable backups entirely.
#
# Option A — NAS mounted as a local volume (see docker-compose.yml for volume mount):
#BACKUP_DESTINATION=/backups
#
# Option B — rsync over SSH to a NAS:
#BACKUP_DESTINATION=user@192.168.1.50:/volume1/claude-backups/
#BACKUP_SSH_KEY=/run/secrets/backup_key   # path inside container; mount via volumes
#
# How often to run (hours, decimals OK):
#BACKUP_INTERVAL_HOURS=24
#
# How many timestamped copies to keep at the destination (local mode only):
#BACKUP_KEEP=7
