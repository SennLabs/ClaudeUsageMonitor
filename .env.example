# Shared bearer token used to authenticate both /v1/logs (OTLP ingestion,
# port 8000 is exposed for dev containers to reach) and /api/* (the
# dashboard's read endpoints, proxied through nginx). Leave blank to disable
# auth entirely - fine for a trusted local/private network, but set a real
# value before exposing this beyond that.
INGEST_AUTH_TOKEN=

# ── Backup ────────────────────────────────────────────────────────────────────
# Leave BACKUP_DESTINATION blank to disable backups entirely.
#
# Option A — NAS mounted as a local volume (see docker-compose.yml for volume mount):
#BACKUP_DESTINATION=/backups
#
# Option B — rsync over SSH to a NAS:
#BACKUP_DESTINATION=user@192.168.1.50:/volume1/claude-backups/
#BACKUP_SSH_KEY=/run/secrets/backup_key   # path inside container; mount via volumes
#
# How often to run (hours, decimals OK):
#BACKUP_INTERVAL_HOURS=24
#
# How many timestamped copies to keep at the destination (local mode only):
#BACKUP_KEEP=7
